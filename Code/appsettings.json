{
  // AL-ZARD_GameMaker 기본 설정 (설치 폴더). 새 버전을 설치하면 이 파일은 새 것으로 바뀝니다.
  // 앱 화면에서 바꾼 값(그림 도구 폴더 등)은 %LOCALAPPDATA%\AL-ZARD_GAMEMAKER\settings.json 에 따로 남습니다 — 직접 고칠 때도 그쪽에 쓰세요.

  // 그림 도구 ComfyUI 포터블 폴더 (run_nvidia_gpu.bat 이 있는 곳). 비우면 = 없음 (그림 기능만 꺼지고 나머지는 됩니다)
  "ComfyRoot": "",
  "ComfyUrl": "http://127.0.0.1:8188",
  // 워크플로·결과·프로젝트(팀 문서·게임) 폴더. 비우면 문서\AL-ZARD_GAMEMAKER (설치 폴더 안은 안 됨 — 새 버전 설치·제거 때 지워질 수 있어 기본으로 돌아감)
  "DataDir": "",
  // 앱을 닫을 때, 앱이 직접 띄운 ComfyUI 도 같이 끈다
  "StopServerOnExit": true,
  // 오른쪽 터미널이 실행하는 Claude Code. PATH 에 없으면 전체 경로 (예: C:\\Users\\<나>\\.local\\bin\\claude.exe)
  "ClaudeExe": "claude",
  // 터미널 claude 에 덧붙일 인자. 파일 편집은 묻지 않고, 셸 명령은 터미널에서 확인창
  "ClaudeArgs": "--permission-mode acceptEdits",
  // 오른쪽 AI 칸의 기본 엔진: "auto"(자동) · "claude" · "gpt" · "gemini". 화면 위쪽 [자동][CLAUDE][GPT][GEMINI] 에서 바꾼 값이 settings.json 에 남아 이 값보다 우선합니다.
  // 자동 = 새 대화를 열 때 Claude → GPT → GEMINI 순서로, 깔려 있고 남은 사용량이 10% 이상인 첫 AI
  "AiEngine": "auto",
  // GPT 칸이 실행하는 Codex CLI. PATH·npm 전역 폴더에 없으면 전체 경로 (예: C:\\Users\\<나>\\AppData\\Roaming\\npm\\codex.cmd)
  "CodexExe": "codex",
  // 터미널 codex 에 덧붙일 인자. 기본 = 작업 폴더 안에만 쓰기, 그 밖·인터넷 명령은 승인창 (비우면 Codex 기본 설정을 따름)
  "CodexArgs": "-s workspace-write -a on-request",
  // GEMINI 칸이 실행하는 Antigravity CLI. PATH·설치 스크립트 자리(%LOCALAPPDATA%\\agy\\bin)에 없으면 전체 경로
  "AgyExe": "agy",
  // GEMINI 칸 모델. 비우거나 다른 값을 넣으면 그 모델로 — 기본은 무료 Gemini 묶음 (agy 기본 모델은 따로 세는 한도를 씀)
  "AgyModel": "gemini-3.8-flash-high",
  // 터미널 agy 에 덧붙일 인자. 기본 = 파일 고치기는 묻지 않고, 셸 명령은 승인창
  "AgyArgs": "--mode accept-edits",
  // 터미널 claude 가 curl 로 그림 생성을 요청하는 포트 (http://127.0.0.1:<port>/run). 0 = 켤 때마다 빈 포트를 골라 Claude 에게 알려 줌
  "ControlPort": 0,
  // Godot 실행 파일. 비우면 설치 폴더\godot\ → PATH 순서로 찾음
  "GodotExe": ""
}
